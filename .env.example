# JEV (TypeSafe System One) — server-side only. The playground still runs
# without it: with no key the snake demo degrades to a local policy and says so.
#
# Deployed path (Vercel AI Gateway, free tier):
AI_GATEWAY_API_KEY=
# Local dev / fallback (official direct backend, model `jev-latest`):
TYPESAFE_API_KEY=
#
# Local rate limit around the provider (token bucket). The sustained default is
# 240/min because one snake round asks once per tick (67/min at 900 ms, 171/min
# at 350 ms); set these to run the brief's 30/min baseline instead.
# JEV_RATE_PER_MINUTE=240
# JEV_RATE_BURST=30
#
# AI-call page (/s/jev → 提问) — server-side only, and the only key the free
# trial needs. The web pages call this provider through OpenRouter (see
# src/lib/ai/models.ts for the chain). Without it the panel says the service
# has no provider, the two demos fall back to their local policy, and no trial
# unit is spent.
OPENROUTER_API_KEY=
#
# Free trial: FREE_DAILY_LIMIT calls a day per IP + browser (see
# src/lib/ai/quota.ts), shared by the chat panel and the two games' rounds.
# Bypass it for local work, or exempt one address.
# FREE_LIMITS_BYPASS=1
# FREE_LIMITS_WHITELIST=
#
# Local rate limit around OpenRouter (same token bucket as the JEV layer).
# AI_RATE_BURST=10
# AI_RATE_PER_MINUTE=30
